# xiwnn 管理后台 systemd 服务（Linux 服务器通用方案）
# 用法：将本文件放到 /etc/systemd/system/xiwnn-admin.service
# 然后执行：
#   systemctl daemon-reload
#   systemctl enable --now xiwnn-admin
#   systemctl status xiwnn-admin
# 若使用宝塔的 Python 项目管理器，可跳过本文件，按部署指南第 5 步操作

[Unit]
Description=xiwnn Admin Panel
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/xiwnn/admin
# 把下面这行的 python3 换成你的 Python 3.8+ 实际路径（可用 which python3 查看）
ExecStart=/usr/bin/python3 /var/www/xiwnn/admin/server.py --host 127.0.0.1 --port 8124
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
